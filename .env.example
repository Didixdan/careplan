# Variables d'environnement — CarePlan. Copier en `.env` (ignoré par Git) :
#     cp .env.example .env

# Base de données locale, lue par docker-compose.yml.
# Le mot de passe ne doit contenir ni @ : / ? # ni espace, sinon DATABASE_URL
# devient invalide. En production, seule DATABASE_URL compte (base Neon).
POSTGRES_USER=careplan
POSTGRES_PASSWORD=careplan_local_dev
POSTGRES_DB=careplan

# Port exposé sur la machine hôte : passer à 5433 si 5432 est déjà pris.
POSTGRES_PORT=5432

# Connexion utilisée par l'application (étapes 2 et suivantes) : à garder
# cohérente avec les variables ci-dessus.
# En production : endpoint « pooled » pour l'application, « direct » pour les
# migrations.
DATABASE_URL="postgresql://careplan:careplan_local_dev@localhost:5432/careplan"

# Chiffrement des cookies de session (étape 3, nuxt-auth-utils) : 32 caractères
# minimum, générés avec `openssl rand -base64 32`. Jamais committé.
NUXT_SESSION_PASSWORD=""
